{
  "name": "js_ydlp",
  "version": "2.0.0",
  "description": "A high-performance 1:1 Vanilla JavaScript port of yt-dlp to use as a local library",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./min": "./dist/js_ydlp.min.js",
    "./bundle": "./dist/js_ydlp.bundle.js",
    "./youtube": "./dist/js_ydlp.youtube.min.js",
    "./tiktok": "./dist/js_ydlp.tiktok.min.js",
    "./utils": "./src/utils/index.js",
    "./utils/*": "./src/utils/*.js",
    "./networking": "./src/networking/index.js",
    "./networking/*": "./src/networking/*.js",
    "./downloader": "./src/downloader/index.js",
    "./downloader/*": "./src/downloader/*.js",
    "./extractor": "./src/extractor/index.js",
    "./extractor/*": "./src/extractor/*.js",
    "./postprocessor": "./src/postprocessor/index.js",
    "./postprocessor/*": "./src/postprocessor/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.js build",
    "test": "node --test test/**/*.test.js",
    "headers:check": "node scripts/header-generator.js --check",
    "headers:apply": "node scripts/header-generator.js --apply"
  },
  "keywords": [
    "yt-dlp",
    "youtube",
    "video",
    "audio",
    "downloader",
    "extractor",
    "vanilla-js",
    "innertube",
    "media"
  ],
  "author": "Axel Caruso",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "terser": "^5.51.2"
  }
}
